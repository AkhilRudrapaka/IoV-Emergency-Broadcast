# Regenerated on every demo / single run: content-identical timestamped archives, the SUMO-GUI log, the live feed
results/urban/raw/*__*.json.gz
results/urban/sumo_gui_errors.log
results/urban/live_demo.json
results/urban/live_demo.json.tmp
# Faculty-demo comparison pairs (python run.py pair / demo --pair): scenario, re-simulated record, live feed, captures
results/demo_pairs/
# Bulk per-scenario records are regenerated by `python run.py experiment`; keep only the demo scenario's record
results/urban/raw/*
!results/urban/raw/d200_r02.json.gz
results/urban/sensitivity/*/raw/
results/urban/sensitivity/*/infrastructure/
